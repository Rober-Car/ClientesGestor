rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // FUNCIONES GENERALES
    // =========================================================

    function autenticado() {
      return request.auth != null;
    }

    function usuarioActual() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function esAdmin() {
      let u = usuarioActual();
      return u.rol == "ADMIN"
        && u.activo == true;
    }

    function esCliente() {
      let u = usuarioActual();
      return u.rol == "CLIENTE"
        && u.activo == true;
    }

    // Una sola lectura de la ficha del cliente del usuario autenticado.
    function servicioContratadoPorCliente(servicio) {
      let clienteId = usuarioActual().clienteId;
      let servicios = (clienteId is int)
        ? get(
            /databases/$(database)/documents/clientes/$(clienteId)
          ).data.serviciosContratados
        : null;
      return servicio is string
        && servicios is list
        && servicio in servicios;
    }

    // VIA 2: un CLIENTE crea su propia ficha con el codigo maestro + DNI.
    // El Batch crea clientes/{idCliente}, indices_clientes/{negocioId}_{dni}
    // y deja usuarios/{uid} apuntando al cliente y negocio correctos.
    // La ficha debe llevar el DNI del propio perfil pendiente del usuario.
    function creacionDirectaValida(clienteId, negocioId) {
      let perfilRef = /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid);
      let clienteRef = /databases/$(database)/documents/clientes/$(clienteId);
      let usuarioRef = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(perfilRef)
        && get(perfilRef).data.dni is string
        && existsAfter(clienteRef)
        && getAfter(clienteRef).data.firebaseUid == request.auth.uid
        && getAfter(clienteRef).data.negocioId == negocioId
        && getAfter(clienteRef).data.idCliente == clienteId
        && getAfter(clienteRef).data.dni == get(perfilRef).data.dni
        && getAfter(usuarioRef).data.clienteId == clienteId
        && getAfter(usuarioRef).data.negocioId == negocioId;
    }

    // VIA 1: un CLIENTE vincula su UID a una ficha existente creada por el
    // ADMIN (identificada por codigo maestro + DNI). El Batch escribe el UID
    // en clientes/{clienteId} y deja usuarios/{uid} apuntando al mismo cliente
    // y negocio. La ficha debe estar libre (firebaseUid == null), pertenecer
    // al negocio indicado y tener exactamente el DNI del perfil pendiente.
    function vinculacionDniValida(clienteId, nuevoUid, nuevoNegocioId) {
      let perfilRef = /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid);
      let clienteRef = /databases/$(database)/documents/clientes/$(clienteId);
      let usuarioRef = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(perfilRef)
        && get(perfilRef).data.dni is string
        && exists(clienteRef)
        && existsAfter(clienteRef)
        && get(clienteRef).data.idCliente == clienteId
        && get(clienteRef).data.firebaseUid == null
        && get(clienteRef).data.negocioId == nuevoNegocioId
        && get(clienteRef).data.dni == get(perfilRef).data.dni
        && getAfter(clienteRef).data.firebaseUid == nuevoUid
        && getAfter(clienteRef).data.negocioId == nuevoNegocioId
        && getAfter(usuarioRef).data.clienteId == clienteId
        && getAfter(usuarioRef).data.negocioId == nuevoNegocioId;
    }

    // El documento del indice solo enlaza negocio+DNI -> ficha.
    function indiceBienFormado(indiceId) {
      return request.resource.data.keys().hasOnly(["negocioId", "dni", "clienteId"])
        && request.resource.data.negocioId is string
        && request.resource.data.dni is string
        && request.resource.data.clienteId is int
        && indiceId == request.resource.data.negocioId + "_" + request.resource.data.dni;
    }

    // El ADMIN crea el indice en el mismo Batch que crea la ficha de su negocio.
    function indiceCreadoPorAdmin(indiceId) {
      let clienteRef = /databases/$(database)/documents/clientes/$(request.resource.data.clienteId);
      return esAdmin()
        && indiceBienFormado(indiceId)
        && request.resource.data.negocioId == usuarioActual().negocioId
        && existsAfter(clienteRef)
        && getAfter(clienteRef).data.negocioId == usuarioActual().negocioId;
    }

    // El CLIENTE crea el indice en el mismo Batch que crea su propia ficha
    // (VIA 2). El DNI del indice debe ser el del perfil pendiente.
    function indiceCreadoPorCliente(indiceId) {
      let clienteRef = /databases/$(database)/documents/clientes/$(request.resource.data.clienteId);
      let perfilRef = /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid);
      return esCliente()
        && indiceBienFormado(indiceId)
        && existsAfter(clienteRef)
        && getAfter(clienteRef).data.firebaseUid == request.auth.uid
        && exists(perfilRef)
        && request.resource.data.dni == get(perfilRef).data.dni;
    }

    function sesionDelNegocio(sesionId) {
      return get(
        /databases/$(database)/documents/sesiones/$(sesionId)
      ).data.negocioId == usuarioActual().negocioId;
    }

    // Una sola lectura de la sesion: negocio propio, cliente autorizado
    // en ella y servicio contratado por el cliente autenticado.
    function sesionAccesiblePorCliente(sesionId) {
      let sesion = get(
        /databases/$(database)/documents/sesiones/$(sesionId)
      ).data;
      return sesion.negocioId == usuarioActual().negocioId
        && request.auth.uid in sesion.clientesPermitidos
        && servicioContratadoPorCliente(sesion.servicio);
    }


    // =========================================================
    // NEGOCIOS
    // =========================================================

    match /negocios/{negocioId} {
      allow get: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid;

      allow list: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid;

      allow create: if esAdmin()
        && usuarioActual().negocioId == null
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.codigoMaestro is string
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.negocioId == negocioId;

      allow update: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.adminUid == request.auth.uid;

      allow delete: if false;
    }


    // =========================================================
    // NEGOCIOS PUBLICOS
    // =========================================================

    match /negocios_publicos/{negocioId} {
      allow get, list: if autenticado();

      allow create: if esAdmin()
        && request.resource.data.keys()
            .hasOnly(["codigoMaestro", "nombre", "logo"])
        && usuarioActual().negocioId == null
        && request.resource.data.codigoMaestro is string
        && request.resource.data.nombre is string
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.negocioId == negocioId;

      allow update: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["codigoMaestro", "nombre", "logo"]);

      allow delete: if false;
    }


    // =========================================================
    // USUARIOS
    // =========================================================

    match /usuarios/{uid} {
      allow get: if autenticado()
        && request.auth.uid == uid;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.rol in ["ADMIN", "CLIENTE"]
        && request.resource.data.activo == true
        && request.resource.data.clienteId == null
        && request.resource.data.negocioId == null;

      // Un ADMIN nuevo puede crear su negocio, pero no vincularse a uno ajeno.
      allow update: if esAdmin()
        && request.auth.uid == uid
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["negocioId"])
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && request.resource.data.clienteId == resource.data.clienteId
        && getAfter(
          /databases/$(database)/documents/negocios/$(request.resource.data.negocioId)
        ).data.adminUid == request.auth.uid;

      // VIA 1: vincularse a una ficha existente identificada por codigo+Dni.
      allow update: if esCliente()
        && request.auth.uid == uid
        && resource.data.clienteId == null
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["clienteId", "negocioId"])
        && request.resource.data.clienteId is int
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && vinculacionDniValida(
             request.resource.data.clienteId,
             request.auth.uid,
             request.resource.data.negocioId
           );

      // VIA 2: un CLIENTE se vincula creando su propia ficha con el codigo
      // maestro; la misma operacion crea clientes/{idCliente} y el indice.
      allow update: if esCliente()
        && request.auth.uid == uid
        && resource.data.clienteId == null
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["clienteId", "negocioId"])
        && request.resource.data.clienteId is int
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && creacionDirectaValida(
             request.resource.data.clienteId,
             request.resource.data.negocioId
           );

      allow delete: if false;
    }


    // =========================================================
    // CLIENTES
    // =========================================================

    match /clientes/{clienteId} {
      allow get: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      // CLIENTE ya vinculado: solo puede leer su propia ficha.
      allow get: if esCliente()
        && string(usuarioActual().clienteId) == clienteId
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.firebaseUid == request.auth.uid;

      // VIA 1: CLIENTE aun sin vincular (clienteId/negocioId null) declara en
      // perfiles_pendientes/{uid} la combinacion { dni, negocioId } que quiere
      // vincular. Solo puede leer la ficha cuyo DNI y negocioId coinciden con
      // esa declaracion y cuyo documentId corresponde a su idCliente. No puede
      // leer fichas arbitrarias, de otros negocios ni de otros DNIs.
      allow get: if esCliente()
        && usuarioActual().clienteId == null
        && usuarioActual().negocioId == null
        && exists(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           )
        && get(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           ).data.dni is string
        && get(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           ).data.negocioId is string
        && get(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           ).data.dni == resource.data.dni
        && get(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           ).data.negocioId == resource.data.negocioId
        && string(resource.data.idCliente) == clienteId;

      // VIA 2: lectura de una ficha AUN NO CREADA (resource == null) dentro de
      // la Transaction que la va a crear. Solo un CLIENTE sin vinculo con perfil
      // pendiente puede comprobar que clientes/{id} no existe; al exigir
      // resource == null no permite leer los datos de fichas existentes de otros.
      allow get: if esCliente()
        && usuarioActual().clienteId == null
        && usuarioActual().negocioId == null
        && exists(
             /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
           )
        && resource == null;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      // Alta por el ADMIN: la ficha nace sin UID y sin indice propio hasta
      // que se replica; el indice se crea en el mismo Batch (Vía 1).
      // observaciones NO vive aqui: esta en clientes_privados/{idCliente}.
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly([
           "idCliente",
           "negocioId",
           "firebaseUid",
           "nombre",
           "apellidos",
           "dni",
           "telefono",
           "email",
           "foto",
           "fechaNacimiento",
           "fechaRegistro",
           "fechaAlta",
           "fechaBaja",
           "estado",
           "tieneLlave",
           "serviciosContratados",
           "fechaInicioActual",
           "fechaFinActual"
         ])
        && usuarioActual().negocioId is string
        && request.resource.data.negocioId is string
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.idCliente is int
        && request.resource.data.dni is string
        && request.resource.data.serviciosContratados is list
        && existsAfter(
             /databases/$(database)/documents/indices_clientes/$(request.resource.data.negocioId + "_" + request.resource.data.dni)
           )
        && getAfter(
             /databases/$(database)/documents/indices_clientes/$(request.resource.data.negocioId + "_" + request.resource.data.dni)
           ).data.clienteId == request.resource.data.idCliente;

      // VIA 2: el CLIENTE crea su propia ficha con el codigo maestro + DNI.
      // La operacion debe formar parte de la misma Transaction que crea el
      // indice y actualiza usuarios/{uid} (validado por creacionDirectaValida).
      allow create: if esCliente()
        && request.resource.data.keys().hasOnly([
           "idCliente",
           "negocioId",
           "firebaseUid",
           "nombre",
           "apellidos",
           "dni",
           "telefono",
           "email",
           "foto",
           "fechaNacimiento",
           "fechaRegistro",
           "fechaAlta",
           "fechaBaja",
           "estado",
           "tieneLlave",
           "serviciosContratados",
           "fechaInicioActual",
           "fechaFinActual"
         ])
        && request.resource.data.negocioId is string
        && request.resource.data.idCliente is int
        && string(request.resource.data.idCliente) == clienteId
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.dni is string
        && request.resource.data.serviciosContratados is list
        && creacionDirectaValida(
             request.resource.data.idCliente,
             request.resource.data.negocioId
           )
        && existsAfter(
             /databases/$(database)/documents/indices_clientes/$(request.resource.data.negocioId + "_" + request.resource.data.dni)
           )
        && getAfter(
             /databases/$(database)/documents/indices_clientes/$(request.resource.data.negocioId + "_" + request.resource.data.dni)
           ).data.clienteId == request.resource.data.idCliente;

      // VIA 1: el CLIENTE completa la vinculacion escribiendo su UID en una
      // ficha libre dentro del Batch que actualiza usuarios/{uid}.
      allow update: if esCliente()
        && request.resource.data.firebaseUid == request.auth.uid
        && resource.data.firebaseUid == null
        && resource.data.negocioId is string
        && request.resource.data.negocioId == resource.data.negocioId
        && resource.data.idCliente is int
        && string(resource.data.idCliente) == clienteId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["firebaseUid", "negocioId"])
        && vinculacionDniValida(
             resource.data.idCliente,
             request.auth.uid,
             request.resource.data.negocioId
           );

      // El CLIENTE vinculado puede editar sus datos personales, pero no el
      // DNI (identifica la ficha), ni campos administrativos ni el perfil.
      allow update: if esCliente()
        && string(usuarioActual().clienteId) == clienteId
        && resource.data.firebaseUid == request.auth.uid
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.idCliente == resource.data.idCliente
        && request.resource.data.dni == resource.data.dni
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.fechaAlta == resource.data.fechaAlta
        && request.resource.data.fechaBaja == resource.data.fechaBaja
        && request.resource.data.fechaInicioActual == resource.data.fechaInicioActual
        && request.resource.data.fechaFinActual == resource.data.fechaFinActual
        && request.resource.data.tieneLlave == resource.data.tieneLlave
        && request.resource.data.serviciosContratados == resource.data.serviciosContratados
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nombre",
              "apellidos",
              "telefono",
              "email",
              "foto",
              "fechaNacimiento"
            ]);

      // El ADMIN edita la ficha. Si cambia el DNI debe mantener el indice
      // atomico: el nuevo indice nace y el viejo se borra en el mismo Batch.
      allow update: if esAdmin()
        && usuarioActual().negocioId is string
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.negocioId is string
        && request.resource.data.negocioId == resource.data.negocioId
        && resource.data.idCliente is int
        && request.resource.data.idCliente == resource.data.idCliente
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nombre",
              "apellidos",
              "dni",
              "telefono",
              "email",
              "foto",
              "fechaNacimiento",
              "serviciosContratados",
              "estado",
              "fechaAlta",
              "fechaBaja",
              "fechaInicioActual",
              "fechaFinActual",
              "tieneLlave"
            ])
        && (request.resource.data.dni == resource.data.dni
            || (existsAfter(
                  /databases/$(database)/documents/indices_clientes/$(resource.data.negocioId + "_" + request.resource.data.dni)
                )
                && !existsAfter(
                     /databases/$(database)/documents/indices_clientes/$(resource.data.negocioId + "_" + resource.data.dni)
                   )
                && getAfter(
                     /databases/$(database)/documents/indices_clientes/$(resource.data.negocioId + "_" + request.resource.data.dni)
                   ).data.clienteId == resource.data.idCliente));

      allow delete: if false;
    }


    // =========================================================
    // CLIENTES PRIVADOS (datos exclusivos del ADMIN)
    // =========================================================

    // observaciones (y cualquier dato interno) NO pertenece a clientes/{id};
    // vive en este documento accesible solo por el ADMIN del negocio, de modo
    // que un CLIENTE nunca pueda leerlo ni modificarlo.
    match /clientes_privados/{idCliente} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(["negocioId", "observaciones"])
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["observaciones"]);

      allow delete: if false;
    }


    // =========================================================
    // PERFILES PENDIENTES (CLIENTE registrado sin negocio)
    // =========================================================

    // Datos temporales de un CLIENTE que aun no pertenece a un negocio.
    // Admite DOS modos:
    //   - VIA 1 (declaracion de vinculacion): solo { dni, negocioId } escritos
    //     al introducir codigo maestro + DNI, para poder consultar el indice.
    //   - VIA 2 (perfil completo): nombre, apellidos, dni, telefono, email,
    //     foto, fechaNacimiento, cuando el cliente pulsa "No tengo codigo".
    // Solo su propio uid puede leerlo, crearlo, editarlo o borrarlo.
    // Se elimina al completar (o al rechazar) la vinculacion.
    match /perfiles_pendientes/{uid} {
      allow get: if autenticado()
        && request.auth.uid == uid;

      allow list: if false;

      allow create: if esCliente()
        && request.auth.uid == uid
        && request.resource.data.dni is string
        && request.resource.data.keys().hasOnly([
           "nombre",
           "apellidos",
           "dni",
           "telefono",
           "email",
           "foto",
           "fechaNacimiento",
           "negocioId"
         ]);

      allow update: if esCliente()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nombre",
              "apellidos",
              "dni",
              "telefono",
              "email",
              "foto",
              "fechaNacimiento",
              "negocioId"
            ]);

      allow delete: if esCliente()
        && request.auth.uid == uid;
    }


    // =========================================================
    // INDICES DE CLIENTES (unicidad negocio+DNI)
    // =========================================================

    // Localiza la ficha por negocio+DNI y garantiza que solo exista una
    // ficha por combinacion. El documentId es {negocioId}_{dni}.
    match /indices_clientes/{indiceId} {
      // Un CLIENTE solo puede leer la combinacion negocio+DNI que declaro en
      // su perfil pendiente (VÍA 1: { dni, negocioId } / VÍA 2: dni). No puede
      // enumerar indices de otros ni leer otros negocios: se exige que el
      // negocioId y el DNI del indice coincidan con los declarados por el uid.
      // Un ADMIN puede leer los indices de su negocio (para mantenerlos).
      allow get: if autenticado()
        && (esAdmin()
              && resource.data.negocioId == usuarioActual().negocioId
            || resource == null
            || (exists(
                  /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
                )
                && get(
                     /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
                   ).data.dni == resource.data.dni
                && get(
                     /databases/$(database)/documents/perfiles_pendientes/$(request.auth.uid)
                   ).data.negocioId == resource.data.negocioId));

      allow list: if false;

      allow create: if indiceCreadoPorAdmin(indiceId)
        || indiceCreadoPorCliente(indiceId);

      allow update: if false;

      // El ADMIN solo borra un indice al cambiar el DNI de la ficha, en el
      // mismo Batch que crea el nuevo indice.
      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && getAfter(
             /databases/$(database)/documents/clientes/$(resource.data.clienteId)
           ).data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // MOVIMIENTOS
    // =========================================================

    match /movimientos/{movimientoId} {
      allow get: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // CLASES
    // =========================================================

    match /clases/{claseId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // SESIONES
    // =========================================================

    match /sesiones/{sesionId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.auth.uid in resource.data.clientesPermitidos
        && servicioContratadoPorCliente(resource.data.servicio);

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // RESERVAS
    // =========================================================

    match /reservas/{reservaId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.clienteId == usuarioActual().clienteId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.sesionId is int
        && sesionDelNegocio(request.resource.data.sesionId);

      allow create: if esCliente()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.clienteId == usuarioActual().clienteId
        && request.resource.data.sesionId is int
        && sesionAccesiblePorCliente(request.resource.data.sesionId);

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if false;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.clienteId == usuarioActual().clienteId;
    }


    // =========================================================
    // SOLICITUDES
    // =========================================================

    match /solicitudes/{solicitudId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.idCliente == usuarioActual().clienteId;

      allow create: if esCliente()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.idCliente == usuarioActual().clienteId
        && request.resource.data.estado == "PENDIENTE"
        && request.resource.data.tipo in ["ALTA", "BAJA"];

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if false;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if false;
    }


    // =========================================================
    // BLOQUEO POR DEFECTO
    // =========================================================

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
