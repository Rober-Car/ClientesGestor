rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // FUNCIONES GENERALES
    // =========================================================

    function autenticado() {
      return request.auth != null;
    }

    function usuarioActual() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function esAdmin() {
      let u = usuarioActual();
      return u.rol == "ADMIN"
        && u.activo == true;
    }

    function esCliente() {
      let u = usuarioActual();
      return u.rol == "CLIENTE"
        && u.activo == true;
    }

    // Una sola lectura de la ficha del cliente del usuario autenticado.
    function servicioContratadoPorCliente(servicio) {
      let clienteId = usuarioActual().clienteId;
      let servicios = (clienteId is int)
        ? get(
            /databases/$(database)/documents/clientes/$(clienteId)
          ).data.serviciosContratados
        : null;
      return servicio is string
        && servicios is list
        && servicio in servicios;
    }

    // Valida atomicamente el Batch completo de consumicion de una
    // vinculacion: el codigo pasa de PENDIENTE a USADA, no esta caducado,
    // pertenece al negocio destino y el Batch deja la ficha del cliente
    // ligada al UID autenticado. Realiza exactamente 2 get y 2 getAfter.
    function vinculacionValidaParaConsumo(clienteId, nuevoUid, nuevoNegocioId) {
      let cliente = get(
        /databases/$(database)/documents/clientes/$(clienteId)
      ).data;
      let codigo = cliente.codigoVinculacion;
      let vinculo = (codigo is string)
        ? get(
            /databases/$(database)/documents/vinculaciones/$(codigo)
          ).data
        : null;
      let vinculoDespues = (codigo is string)
        ? getAfter(
            /databases/$(database)/documents/vinculaciones/$(codigo)
          ).data
        : null;
      let clienteDespues = getAfter(
        /databases/$(database)/documents/clientes/$(clienteId)
      ).data;
      return codigo is string
        && cliente.idCliente == clienteId
        && cliente.firebaseUid == null
        && vinculo != null
        && vinculo.estado == "PENDIENTE"
        && vinculo.fechaExpiracion > request.time
        && vinculo.negocioId == nuevoNegocioId
        && vinculoDespues.estado == "USADA"
        && vinculoDespues.clienteId == cliente.idCliente
        && vinculoDespues.negocioId == vinculo.negocioId
        && clienteDespues.firebaseUid == nuevoUid
        && clienteDespues.negocioId == vinculo.negocioId;
    }

    // Comprueba que el mismo Batch deja usuarios/{uid} apuntando al
    // cliente y al negocio de la vinculacion consumida.
    function usuarioApuntaACliente(clienteId, negocioId) {
      let usuarioDespues = getAfter(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
      return usuarioDespues.clienteId == clienteId
        && usuarioDespues.negocioId == negocioId;
    }

    // Valida el Batch de asignacion/regeneracion de un token individual
    // (Via B): el documento vinculaciones/{token} nace en el mismo Batch,
    // PENDIENTE, sin caducar y apuntando a la ficha y negocio indicados.
    function asignacionTokenValida(token, clienteId, negocioId) {
      return token is string
        && !exists(
          /databases/$(database)/documents/vinculaciones/$(token)
        )
        && getAfter(
            /databases/$(database)/documents/vinculaciones/$(token)
          ).data.estado == "PENDIENTE"
        && getAfter(
            /databases/$(database)/documents/vinculaciones/$(token)
          ).data.clienteId == clienteId
        && getAfter(
            /databases/$(database)/documents/vinculaciones/$(token)
          ).data.negocioId == negocioId
        && getAfter(
            /databases/$(database)/documents/vinculaciones/$(token)
          ).data.fechaExpiracion > request.time;
    }

    // Exige que el token activo de la ficha siga PENDIENTE, del propio
    // negocio y apuntando a ese cliente, antes de limpiar su campo en el
    // mismo Batch que elimina el documento de vinculacion.
    function revocacionTokenValida(token, clienteId, negocioId) {
      let vinculo = get(
        /databases/$(database)/documents/vinculaciones/$(token)
      ).data;
      return vinculo.estado == "PENDIENTE"
        && vinculo.clienteId == clienteId
        && vinculo.negocioId == negocioId;
    }

    // Valida atomicamente la creacion directa de la ficha por parte de un
    // CLIENTE mediante el codigo maestro (Via A): la misma operacion debe
    // crear la ficha ligada al UID autenticado y dejar usuarios/{uid}
    // apuntando al cliente y al negocio correctos. Realiza 2 getAfter.
    function creacionDirectaValida(clienteId, negocioId) {
      let clienteDespues = getAfter(
        /databases/$(database)/documents/clientes/$(clienteId)
      ).data;
      let usuarioDespues = getAfter(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
      return clienteDespues.firebaseUid == request.auth.uid
        && clienteDespues.negocioId == negocioId
        && clienteDespues.idCliente == clienteId
        && usuarioDespues.clienteId == clienteId
        && usuarioDespues.negocioId == negocioId;
    }

    function sesionDelNegocio(sesionId) {
      return get(
        /databases/$(database)/documents/sesiones/$(sesionId)
      ).data.negocioId == usuarioActual().negocioId;
    }

    // Una sola lectura de la sesion: negocio propio, cliente autorizado
    // en ella y servicio contratado por el cliente autenticado.
    function sesionAccesiblePorCliente(sesionId) {
      let sesion = get(
        /databases/$(database)/documents/sesiones/$(sesionId)
      ).data;
      return sesion.negocioId == usuarioActual().negocioId
        && request.auth.uid in sesion.clientesPermitidos
        && servicioContratadoPorCliente(sesion.servicio);
    }


    // =========================================================
    // NEGOCIOS
    // =========================================================

    match /negocios/{negocioId} {
      allow get: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid;

      // Las consultas deben filtrar por documentId/negocioId para que
      // Firestore pueda demostrar que solo devuelven el negocio propio.
      allow list: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid;

      // Debe formar parte del mismo Batch que actualiza usuarios/{uid}.
      // El negocio nace con su codigo maestro; no existe contadorClientes:
      // los idCliente se generan como enteros aleatorios unicos en clientes.
      allow create: if esAdmin()
        && usuarioActual().negocioId == null
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.codigoMaestro is string
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.negocioId == negocioId;

      allow update: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && resource.data.adminUid == request.auth.uid
        && request.resource.data.adminUid == request.auth.uid;

      allow delete: if false;
    }


    // =========================================================
    // NEGOCIOS PUBLICOS
    // =========================================================

    // Unica informacion visible para localizar el negocio a traves del
    // codigo maestro, sin exponer adminUid ni otros datos sensibles.
    match /negocios_publicos/{negocioId} {
      allow get, list: if autenticado();

      // Debe crearse en el mismo Batch que negocios/{id} y usuarios/{uid}.
      allow create: if esAdmin()
        && request.resource.data.keys()
            .hasOnly(["codigoMaestro", "nombre"])
        && usuarioActual().negocioId == null
        && request.resource.data.codigoMaestro is string
        && request.resource.data.nombre is string
        && getAfter(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.negocioId == negocioId;

      // Solo el ADMIN propietario actualiza el codigo maestro (y el nombre).
      allow update: if esAdmin()
        && usuarioActual().negocioId == negocioId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["codigoMaestro", "nombre"]);

      allow delete: if false;
    }


    // =========================================================
    // USUARIOS
    // =========================================================

    match /usuarios/{uid} {
      allow get: if autenticado()
        && request.auth.uid == uid;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.rol in ["ADMIN", "CLIENTE"]
        && request.resource.data.activo == true
        && request.resource.data.clienteId == null
        && request.resource.data.negocioId == null;

      // Un ADMIN nuevo puede crear su negocio, pero no vincularse a uno ajeno.
      allow update: if esAdmin()
        && request.auth.uid == uid
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["negocioId"])
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && request.resource.data.clienteId == resource.data.clienteId
        && getAfter(
          /databases/$(database)/documents/negocios/$(request.resource.data.negocioId)
        ).data.adminUid == request.auth.uid;

      // La vinculacion de un CLIENTE solo es valida dentro del Batch completo
      // que consume el codigo, marca la ficha del cliente y deja el codigo USADA.
      allow update: if esCliente()
        && request.auth.uid == uid
        && resource.data.clienteId == null
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["clienteId", "negocioId"])
        && request.resource.data.clienteId is int
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && vinculacionValidaParaConsumo(
             request.resource.data.clienteId,
             request.auth.uid,
             request.resource.data.negocioId
           );

      // Via A: el CLIENTE se vincula creando su propia ficha con el codigo
      // maestro; la misma operacion crea clientes/{idCliente} y deja los
      // dos documentos coherentes entre si. Sin vinculacion que consumir.
      allow update: if esCliente()
        && request.auth.uid == uid
        && resource.data.clienteId == null
        && resource.data.negocioId == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["clienteId", "negocioId"])
        && request.resource.data.clienteId is int
        && request.resource.data.negocioId is string
        && request.resource.data.rol == resource.data.rol
        && request.resource.data.activo == resource.data.activo
        && creacionDirectaValida(
             request.resource.data.clienteId,
             request.resource.data.negocioId
           );

      allow delete: if false;
    }


    // =========================================================
    // CLIENTES
    // =========================================================

    match /clientes/{clienteId} {
      allow get: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get: if esCliente()
        && string(usuarioActual().clienteId) == clienteId
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.firebaseUid == request.auth.uid;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly([
           "idCliente",
           "negocioId",
           "firebaseUid",
           "codigoVinculacion",
           "nombre",
           "apellidos",
           "dni",
           "telefono",
           "email",
           "foto",
           "fechaNacimiento",
           "fechaRegistro",
           "fechaAlta",
           "fechaBaja",
           "estado",
           "tieneLlave",
           "observaciones",
           "serviciosContratados",
           "fechaInicioActual",
           "fechaFinActual"
         ])
        && usuarioActual().negocioId is string
        && request.resource.data.negocioId is string
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.idCliente is int
        && (!("codigoVinculacion" in request.resource.data)
          || request.resource.data.codigoVinculacion == null)
        && request.resource.data.serviciosContratados is list;

      // Via A: el CLIENTE crea su propia ficha con el codigo maestro.
      // El identificador es un entero aleatorio unico en toda la coleccion;
      // create solo alcanza documentos que aun no existen, por lo que una
      // colision falla y la app reintenta con otro id. La operacion debe
      // formar parte de la misma Transaction que actualiza usuarios/{uid}.
      allow create: if esCliente()
        && request.resource.data.keys().hasOnly([
           "idCliente",
           "negocioId",
           "firebaseUid",
           "codigoVinculacion",
           "nombre",
           "apellidos",
           "dni",
           "telefono",
           "email",
           "foto",
           "fechaNacimiento",
           "fechaRegistro",
           "fechaAlta",
           "fechaBaja",
           "estado",
           "tieneLlave",
           "observaciones",
           "serviciosContratados",
           "fechaInicioActual",
           "fechaFinActual"
         ])
        && request.resource.data.negocioId is string
        && request.resource.data.idCliente is int
        && string(request.resource.data.idCliente) == clienteId
        && request.resource.data.firebaseUid == request.auth.uid
        && (!("codigoVinculacion" in request.resource.data)
          || request.resource.data.codigoVinculacion == null)
        && request.resource.data.serviciosContratados is list
        && creacionDirectaValida(
             request.resource.data.idCliente,
             request.resource.data.negocioId
           );

      // El cliente solo puede completar su vinculacion con su UID y dentro
      // del Batch que consume el codigo correcto. El negocio escrito debe
      // coincidir con el del codigo y con el que recibe usuarios/{uid}.
      allow update: if esCliente()
        && request.resource.data.firebaseUid == request.auth.uid
        && resource.data.firebaseUid == null
        && resource.data.idCliente is int
        && string(resource.data.idCliente) == clienteId
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["firebaseUid", "negocioId"])
        && vinculacionValidaParaConsumo(
             resource.data.idCliente,
             request.auth.uid,
             request.resource.data.negocioId
           )
        && usuarioApuntaACliente(
             resource.data.idCliente,
             request.resource.data.negocioId
           );

      allow update: if esCliente()
        && string(usuarioActual().clienteId) == clienteId
        && resource.data.firebaseUid == request.auth.uid
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.negocioId == resource.data.negocioId
        && request.resource.data.idCliente == resource.data.idCliente
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.fechaAlta == resource.data.fechaAlta
        && request.resource.data.fechaBaja == resource.data.fechaBaja
        && request.resource.data.fechaInicioActual == resource.data.fechaInicioActual
        && request.resource.data.fechaFinActual == resource.data.fechaFinActual
        && request.resource.data.serviciosContratados == resource.data.serviciosContratados
        && request.resource.data.codigoVinculacion == resource.data.codigoVinculacion
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nombre",
              "apellidos",
              "dni",
              "telefono",
              "email",
              "foto",
              "fechaNacimiento",
              "observaciones"
            ]);

      // SE ELIMINAN las reglas generales de asignacion y revocacion de
      // codigos; quedan sustituidas por los dos bloques estrechos siguientes.

      // Asignar o regenerar el token de vinculacion (Via B) sobre una ficha
      // que aun no tiene UID: atomico con la creacion de vinculaciones/{token}
      // en el mismo Batch (validado por asignacionTokenValida).
      allow update: if esAdmin()
        && usuarioActual().negocioId is string
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.negocioId is string
        && request.resource.data.negocioId == resource.data.negocioId
        && resource.data.idCliente is int
        && request.resource.data.idCliente == resource.data.idCliente
        && resource.data.firebaseUid == null
        && request.resource.data.firebaseUid == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["codigoVinculacion"])
        && asignacionTokenValida(
             request.resource.data.codigoVinculacion,
             resource.data.idCliente,
             resource.data.negocioId
           );

      // Revocar el enlace activo de una ficha sin UID: limpia el campo a null
      // en el mismo Batch que elimina vinculaciones/{token} (delete permitido
      // por su propia regla mientras siga PENDIENTE).
      allow update: if esAdmin()
        && usuarioActual().negocioId is string
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.negocioId is string
        && request.resource.data.negocioId == resource.data.negocioId
        && resource.data.idCliente is int
        && request.resource.data.idCliente == resource.data.idCliente
        && resource.data.firebaseUid == null
        && request.resource.data.firebaseUid == null
        && resource.data.codigoVinculacion is string
        && request.resource.data.codigoVinculacion == null
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["codigoVinculacion"])
        && revocacionTokenValida(
             resource.data.codigoVinculacion,
             resource.data.idCliente,
             resource.data.negocioId
           )
        && !existsAfter(
          /databases/$(database)/documents/vinculaciones/$(resource.data.codigoVinculacion)
        );

      // ADMIN solo puede modificar campos de gestion del cliente propio.
      allow update: if esAdmin()
        && usuarioActual().negocioId is string
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.negocioId is string
        && request.resource.data.negocioId == resource.data.negocioId
        && resource.data.idCliente is int
        && request.resource.data.idCliente == resource.data.idCliente
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "nombre",
              "apellidos",
              "dni",
              "telefono",
              "email",
              "foto",
              "fechaNacimiento",
              "observaciones",
              "serviciosContratados",
              "estado",
              "fechaAlta",
              "fechaBaja",
              "fechaInicioActual",
              "fechaFinActual",
              "tieneLlave"
            ]);

      allow delete: if false;
    }


    // =========================================================
    // MOVIMIENTOS
    // =========================================================

    match /movimientos/{movimientoId} {
      allow get: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // CLASES
    // =========================================================

    match /clases/{claseId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // SESIONES
    // =========================================================

    match /sesiones/{sesionId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.auth.uid in resource.data.clientesPermitidos
        && servicioContratadoPorCliente(resource.data.servicio);

      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;
    }


    // =========================================================
    // RESERVAS
    // =========================================================

    match /reservas/{reservaId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.clienteId == usuarioActual().clienteId;

      // La sesion debe existir y pertenecer al negocio del ADMIN.
      allow create: if esAdmin()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.sesionId is int
        && sesionDelNegocio(request.resource.data.sesionId);

      // El cliente solo puede reservar para si mismo una sesion de su
      // negocio, autorizada para su UID y con el servicio contratado.
      allow create: if esCliente()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.clienteId == usuarioActual().clienteId
        && request.resource.data.sesionId is int
        && sesionAccesiblePorCliente(request.resource.data.sesionId);

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if false;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.clienteId == usuarioActual().clienteId;
    }


    // =========================================================
    // SOLICITUDES
    // =========================================================

    match /solicitudes/{solicitudId} {
      allow get, list: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow get, list: if esCliente()
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.idCliente == usuarioActual().clienteId;

      allow create: if esCliente()
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.idCliente == usuarioActual().clienteId
        && request.resource.data.estado == "PENDIENTE"
        && request.resource.data.tipo in ["ALTA", "BAJA"];

      allow update: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.negocioId == usuarioActual().negocioId;

      allow update: if false;

      allow delete: if esAdmin()
        && resource.data.negocioId == usuarioActual().negocioId;

      allow delete: if false;
    }


    // =========================================================
    // VINCULACIONES
    // =========================================================

    match /vinculaciones/{codigo} {
      allow get: if autenticado()
        && resource.data.estado == "PENDIENTE"
        && resource.data.fechaExpiracion > request.time;

      // Nunca se permite listar todos los codigos.
      allow list: if false;

      // Crear un codigo solo reserva el identificador para el propio
      // negocio; el enlace con la ficha del cliente se valida de forma
      // atomica en la asignacion y en la consumicion.
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly([
          "negocioId",
          "estado",
          "fechaExpiracion",
          "clienteId"
        ])
        && usuarioActual().negocioId is string
        && request.resource.data.negocioId is string
        && request.resource.data.negocioId == usuarioActual().negocioId
        && request.resource.data.estado == "PENDIENTE"
        && request.resource.data.clienteId is int
        && request.resource.data.fechaExpiracion is timestamp
        && request.resource.data.fechaExpiracion > request.time;

      // Este update solo puede ocurrir como parte del Batch de vinculacion.
      allow update: if esCliente()
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["estado"])
        && resource.data.estado == "PENDIENTE"
        && resource.data.fechaExpiracion > request.time
        && request.resource.data.estado == "USADA"
        && request.resource.data.clienteId == resource.data.clienteId
        && request.resource.data.negocioId == resource.data.negocioId
        && vinculacionValidaParaConsumo(
             resource.data.clienteId,
             request.auth.uid,
             resource.data.negocioId
           )
        && usuarioApuntaACliente(
             resource.data.clienteId,
             resource.data.negocioId
           );

      allow update: if esAdmin()
        && usuarioActual().negocioId is string
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.negocioId is string
        && request.resource.data.negocioId == usuarioActual().negocioId
        && resource.data.estado == "PENDIENTE"
        && request.resource.data.estado == "PENDIENTE"
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["fechaExpiracion"])
        && request.resource.data.fechaExpiracion is timestamp
        && request.resource.data.fechaExpiracion > request.time;

      // Revocar un codigo es borrarlo mientras sigue pendiente; solo el
      // ADMIN de su negocio puede hacerlo.
      allow delete: if esAdmin()
        && usuarioActual().negocioId is string
        && resource.data.negocioId == usuarioActual().negocioId
        && resource.data.negocioId is string
        && resource.data.estado == "PENDIENTE";
    }


    // =========================================================
    // BLOQUEO POR DEFECTO
    // =========================================================

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
